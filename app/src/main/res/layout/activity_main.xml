<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#101512" android:padding="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GatsMod Cut • Editor" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#080B09"><androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="true" app:resize_mode="fit"/><TextView android:id="@+id/emptyPreview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Import video" android:textColor="#AAB7AF"/><TextView android:id="@+id/textPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:gravity="center" android:padding="12dp" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:shadowColor="#000000" android:shadowRadius="5" android:visibility="gone"/></FrameLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/importButton" android:text="＋ Video"/><Button android:id="@+id/audioImportButton" android:text="＋ Audio"/><Button android:id="@+id/textClipButton" android:text="＋ Text"/><Button android:id="@+id/overlayButton" android:text="＋ Overlay"/><Button android:id="@+id/srtButton" android:text="Import SRT"/><Button android:id="@+id/textStyleButton" android:text="Text Style"/></LinearLayout></HorizontalScrollView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MULTI-TRACK • Select / drag clip" android:textColor="#7CE6B0" android:textStyle="bold"/><com.gatsmod.cut.TimelineView android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="220dp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/splitButton" android:text="Split"/><Button android:id="@+id/trimStartButton" android:text="Trim Start"/><Button android:id="@+id/trimEndButton" android:text="Trim End"/><Button android:id="@+id/duplicateButton" android:text="Duplicate"/><Button android:id="@+id/deleteButton" android:text="Delete"/><Button android:id="@+id/mergeButton" android:text="Merge"/><Button android:id="@+id/nudgeLeftButton" android:text="◀ 1 Frame"/><Button android:id="@+id/nudgeRightButton" android:text="1 Frame ▶"/></LinearLayout></HorizontalScrollView>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/undoButton" android:text="Undo"/><Button android:id="@+id/redoButton" android:text="Redo"/><Button android:id="@+id/zoomInButton" android:text="Zoom +"/><Button android:id="@+id/zoomOutButton" android:text="Zoom -"/><Button android:id="@+id/addVideoLaneButton" android:text="+ Video Track"/><Button android:id="@+id/addAudioLaneButton" android:text="+ Audio Track"/><Button android:id="@+id/speedButton" android:text="Speed"/></LinearLayout></HorizontalScrollView>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/effectsButton" android:text="Effects &amp; Color"/><Button android:id="@+id/keyframeButton" android:text="Keyframe"/><Button android:id="@+id/chromaButton" android:text="Chroma Key"/><Button android:id="@+id/exportSettingsButton" android:text="Export Settings"/></LinearLayout></HorizontalScrollView>\n<Button android:id="@+id/updateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check App Update"/><TextView android:id="@+id/clipInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Import and select clips" android:textColor="#C8D4CC" android:padding="4dp"/><Button android:id="@+id/exportButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Export MP4" android:enabled="false"/>
</LinearLayout>
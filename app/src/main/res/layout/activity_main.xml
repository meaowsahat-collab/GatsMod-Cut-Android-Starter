<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#101512" android:padding="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GatsMod Cut • Timeline Editor" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#080B09"><androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="true" app:resize_mode="fit"/><TextView android:id="@+id/emptyPreview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="ভিডিও Import করুন" android:textColor="#AAB7AF"/></FrameLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/importButton" android:text="＋ Video" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/audioImportButton" android:text="＋ Audio" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/textClipButton" android:text="＋ Text" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/overlayButton" android:text="＋ Overlay" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></HorizontalScrollView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MULTI-TRACK • Select / drag clip • tap timeline to move playhead" android:textColor="#7CE6B0" android:textStyle="bold" android:paddingTop="5dp"/>
<com.gatsmod.cut.TimelineView android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="220dp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/splitButton" android:text="Split" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/trimStartButton" android:text="Trim Start" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/trimEndButton" android:text="Trim End" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/duplicateButton" android:text="Duplicate" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/deleteButton" android:text="Delete" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/mergeButton" android:text="Merge" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/nudgeLeftButton" android:text="◀ 1 Frame" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/nudgeRightButton" android:text="1 Frame ▶" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></HorizontalScrollView>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/undoButton" android:text="Undo" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/redoButton" android:text="Redo" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/zoomInButton" android:text="Zoom +" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/zoomOutButton" android:text="Zoom -" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/addVideoLaneButton" android:text="+ Video Track" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/addAudioLaneButton" android:text="+ Audio Track" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/speedButton" android:text="Preview Speed" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></HorizontalScrollView>
<TextView android:id="@+id/clipInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Import media and select a timeline clip" android:textColor="#C8D4CC" android:padding="4dp"/>
<Button android:id="@+id/exportButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Export (not yet implemented)" android:textAllCaps="false" android:enabled="false"/>
</LinearLayout>